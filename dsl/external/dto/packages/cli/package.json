{
    "name": "dto-definition-cli",
    "description": "The cli specific package",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src"
    ],
    "bin": {
        "dto-definition-cli": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc -p tsconfig.json",
        "build:clean": "npm run clean && npm run build",
        "test-generate": "npm run build && node bin/cli.js generate ./example.dto"
    },
    "dependencies": {
        "chalk": "~5.3.0",
        "commander": "~11.1.0",
        "dto-definition-language": "0.0.1",
        "handlebars": "^4.7.9"
    }
}
